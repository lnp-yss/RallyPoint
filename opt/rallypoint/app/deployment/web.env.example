# Copy to /etc/rallypoint/web.env, owner root:rallypoint, mode 0640.
# Generate secrets with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Replace all CHANGE_ME values before starting services; URL-encode DB password.
RALLYPOINT_DATABASE_URL=mysql+pymysql://rallypoint:CHANGE_ME@127.0.0.1/rallypoint?charset=utf8mb4
RALLYPOINT_SECRET_KEY=CHANGE_ME
RALLYPOINT_BRIDGE_TOKEN=CHANGE_ME
RALLYPOINT_BRIDGE=1
RALLYPOINT_BRIDGE_PORT=8765
RALLYPOINT_BRIDGE_URL=http://127.0.0.1:8765
RALLYPOINT_DEVICE_ID=1
# Database court ID, not display court number. Unique on every cloned Pi.
RALLYPOINT_COURT_ID=1
RALLYPOINT_DATA_ROOT=/opt/rallypoint/app
RALLYPOINT_PUBLIC_LIVE=true
RALLYPOINT_HTTPS=false
