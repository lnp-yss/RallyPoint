# Clone-specific transport configuration; owner root:rallypoint, mode 0640.
RALLYPOINT_HUB_HOST=rallypoint.local
RALLYPOINT_SSH_USER=rallypoint
RALLYPOINT_SSH_KEY=/home/rallypoint/.ssh/rallypoint-hub
# Unique on the host for each client. Court 2 uses 8766; example Court 3 uses 8767.
RALLYPOINT_REVERSE_PORT=8767
